{
  "rewrites": [
    {
      "source": "/api/query-laws",
      "destination": "https://ktqmwpbzcnzkhjskqisy.supabase.co/functions/v1/chok-ai?mode=query"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
